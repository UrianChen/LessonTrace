# 复制为 .env 后填写。.env 不提交到仓库。

# ---- 入口 ----
# 浏览器访问的地址。签名地址按它生成，换端口或换主机名时这里要跟着改。
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80

# ---- 数据库 ----
POSTGRES_USER=lessontrace
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=lessontrace

# ---- 对象存储（MinIO）----
MINIO_ROOT_USER=lessontrace
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=lessontrace

# ---- 登录令牌签名密钥：填一串至少 32 位的随机字符 ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- 初始账号口令（用户名 teacher / center / admin）。留空则随机生成并打印在 api 日志里 ----
INIT_TEACHER_PASSWORD=
INIT_CENTER_PASSWORD=
INIT_ADMIN_PASSWORD=

# ---- 大模型（只用于「大模型分析」和片段标题；只发送文字稿和课件文字）----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# 模型因安全策略拒答时由服务端换备用模型重跑；不需要可设为 false
LLM_REFUSAL_FALLBACK=true

# ---- 语音转写（WhisperX，在本机 GPU 上运行）----
# medium + int8_float16，4 GB 显存的显卡即可。显存 8 GB 以上想换 large-v2 时，把 COMPUTE_TYPE 改成 float16
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_BATCH_SIZE=4
# 说话人分离用的模型要先在 Hugging Face 上同意使用协议，再填访问令牌；留空则不区分说话人
HF_TOKEN=
